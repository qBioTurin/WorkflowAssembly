#!/usr/bin/env python3
"""Prepare and run WorkflowAssembly without WorkflowService.

The launcher creates an isolated per-run workspace. Reference data can either
be staged by StreamFlow (``transfer``) or passed as an opaque path that already
exists on the compute infrastructure (``hpc-shared``).
"""

from __future__ import annotations

import argparse
import json
import re
import shutil
import subprocess
import sys
from pathlib import Path


REFERENCE_PATCHES = {
    "workflow.cwl": (
        ("  prot_seq: File?", "  prot_seq: string?"),
        ("  db_bakta: Directory?", "  db_bakta: string?"),
    ),
    "cwl/assembly_evaluation_geneprediction.cwl": (
        ("  prot_seq: File?", "  prot_seq: string?"),
        ("  db_bakta: Directory?", "  db_bakta: string?"),
    ),
    "cwl/geneprediction.cwl": (
        ("  prot_seq: File?", "  prot_seq: string?"),
        ("  db_bakta: Directory?", "  db_bakta: string?"),
    ),
    "cwl/geneprediction-eukaryotic.cwl": (
        ("  prot_seq: File?", "  prot_seq: string?"),
    ),
    "cwl/geneprediction-prokaryotic.cwl": (
        ("  db_bakta: Directory?", "  db_bakta: string?"),
    ),
    "cwl/geneprediction/bakta.cwl": (
        ("    type: Directory?", "    type: string?"),
    ),
    "cwl/geneprediction/braker3.cwl": (
        ("  prot_seq:\n    type: File?", "  prot_seq:\n    type: string?"),
    ),
}


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(
        description="Run WorkflowAssembly independently from WorkflowService."
    )
    result.add_argument("--domain", required=True, choices=("prokaryotic", "eukaryotic"))
    result.add_argument("--fastq-directory", required=True, type=Path)
    result.add_argument(
        "--seq-technology", required=True, choices=("nanopore", "pacbio", "pacbio-hifi")
    )
    result.add_argument("--lineage", required=True)
    result.add_argument("--taxon", required=True, type=int)
    result.add_argument("--genome-size")
    result.add_argument("--threads", type=int, default=36)
    result.add_argument("--min-coverage", type=int, default=8)
    result.add_argument("--kingdom", default="Bacteria")
    result.add_argument("--bakta-db", help="Bakta DB path; required only for prokaryotic runs")
    result.add_argument(
        "--protein-fasta", help="Protein FASTA path; required only for eukaryotic runs"
    )
    result.add_argument(
        "--reference-mode",
        choices=("transfer", "hpc-shared"),
        default="transfer",
        help="Transfer a local reference, or pass an existing compute-side path",
    )
    result.add_argument("--output", required=True, type=Path)
    result.add_argument("--workspace", type=Path)
    result.add_argument("--streamflow-config", type=Path)
    result.add_argument("--streamflow-bin", default="streamflow")
    result.add_argument(
        "--prepare-only",
        action="store_true",
        help="Generate and validate the run workspace without starting StreamFlow",
    )
    return result


def fail(message: str) -> None:
    raise ValueError(message)


def local_directory(value: Path, label: str) -> Path:
    resolved = value.expanduser().resolve()
    if not resolved.is_dir():
        fail(f"{label} is not a readable directory: {resolved}")
    return resolved


def local_file(value: Path, label: str) -> Path:
    resolved = value.expanduser().resolve()
    if not resolved.is_file():
        fail(f"{label} is not a readable file: {resolved}")
    return resolved


def validate_args(args: argparse.Namespace) -> None:
    if args.threads <= 0:
        fail("--threads must be greater than zero")
    if args.min_coverage <= 0:
        fail("--min-coverage must be greater than zero")

    args.fastq_directory = local_directory(args.fastq_directory, "FASTQ directory")

    if args.domain == "prokaryotic":
        if not args.bakta_db:
            fail("--bakta-db is required for a prokaryotic run")
        if args.protein_fasta:
            fail("--protein-fasta is not used by a prokaryotic run")
        if args.reference_mode == "transfer":
            args.bakta_db = str(local_directory(Path(args.bakta_db), "Bakta DB"))
    else:
        if not args.protein_fasta:
            fail("--protein-fasta is required for an eukaryotic run")
        if args.bakta_db:
            fail("--bakta-db is not used by an eukaryotic run")
        if args.reference_mode == "transfer":
            args.protein_fasta = str(local_file(Path(args.protein_fasta), "Protein FASTA"))


def apply_hpc_shared_patches(workspace: Path) -> None:
    for relative, replacements in REFERENCE_PATCHES.items():
        target = workspace / relative
        content = target.read_text()
        for replacement in replacements:
            old, new, *expected_override = replacement
            expected = expected_override[0] if expected_override else 1
            count = content.count(old)
            if count != expected:
                fail(
                    f"Reference patch for {relative} expected {expected} occurrence(s) of "
                    f"{old!r}, found {count}"
                )
            content = content.replace(old, new)
        target.write_text(content)


def render_streamflow_config(streamflow_config: Path, content: str) -> str:
    lines = content.splitlines()
    in_cwl_config = False
    workflow_file_rendered = False
    settings_rendered = False

    for index, line in enumerate(lines):
        stripped = line.strip()
        if stripped == "type: cwl" and not workflow_file_rendered:
            in_cwl_config = True
            continue
        if in_cwl_config and stripped.startswith("file:") and not workflow_file_rendered:
            indentation = line[: len(line) - len(line.lstrip())]
            lines[index] = f"{indentation}file: workflow.cwl"
            workflow_file_rendered = True
            continue
        if in_cwl_config and stripped.startswith("settings:") and not settings_rendered:
            indentation = line[: len(line) - len(line.lstrip())]
            lines[index] = f"{indentation}settings: config.yml"
            settings_rendered = True

    if not workflow_file_rendered or not settings_rendered:
        fail(
            "StreamFlow configuration must contain a CWL workflow with both "
            "file and settings entries"
        )

    content = "\n".join(lines) + ("\n" if content.endswith("\n") else "")
    pattern = re.compile(r"^(\s*sshKey:\s*)([^#\n]+?)(\s*)$", re.MULTILINE)

    def replace(match: re.Match[str]) -> str:
        raw = match.group(2).strip().strip("\"'")
        key = Path(raw).expanduser()
        if not key.is_absolute():
            key = (streamflow_config.parent / key).resolve()
        return f"{match.group(1)}{json.dumps(str(key))}{match.group(3)}"

    return pattern.sub(replace, content)


def prepare_workspace(args: argparse.Namespace, repo: Path) -> Path:
    output = args.output.expanduser().resolve()
    workspace = (
        args.workspace.expanduser().resolve()
        if args.workspace
        else output.parent / f".{output.name}.workflow-run"
    )
    if workspace.exists():
        fail(f"Workspace already exists: {workspace}; choose another --workspace")

    streamflow_config = (
        args.streamflow_config.expanduser().resolve()
        if args.streamflow_config
        else repo / "streamflow.yml"
    )
    if not streamflow_config.is_file():
        fail(f"StreamFlow configuration does not exist: {streamflow_config}")

    workspace.mkdir(parents=True)
    (workspace / "database").mkdir()
    shutil.copy2(repo / "workflow.cwl", workspace / "workflow.cwl")
    shutil.copytree(repo / "cwl", workspace / "cwl")
    shutil.copytree(repo / "sbatch", workspace / "sbatch")

    rendered_streamflow = render_streamflow_config(
        streamflow_config, streamflow_config.read_text()
    )
    (workspace / "streamflow.yml").write_text(rendered_streamflow)

    if args.reference_mode == "hpc-shared":
        apply_hpc_shared_patches(workspace)

    config: dict[str, object] = {
        "fastq_directory": {"class": "Directory", "path": str(args.fastq_directory)},
        "threads": args.threads,
        "seq_technology": args.seq_technology,
        "min_coverage": args.min_coverage,
        "lineage": args.lineage,
        "kingdom": args.kingdom,
        "domain": args.domain,
        "taxon": args.taxon,
    }
    if args.genome_size:
        config["genome_size"] = args.genome_size

    if args.domain == "prokaryotic":
        config["db_bakta"] = (
            args.bakta_db
            if args.reference_mode == "hpc-shared"
            else {"class": "Directory", "path": args.bakta_db}
        )
    else:
        config["prot_seq"] = (
            args.protein_fasta
            if args.reference_mode == "hpc-shared"
            else {"class": "File", "path": args.protein_fasta}
        )

    # JSON is valid YAML and avoids adding a YAML library just for the launcher.
    (workspace / "config.yml").write_text(json.dumps(config, indent=2) + "\n")
    (workspace / "run.json").write_text(
        json.dumps(
            {
                "domain": args.domain,
                "referenceMode": args.reference_mode,
                "output": str(output),
                "streamflowConfigSource": str(streamflow_config),
            },
            indent=2,
        )
        + "\n"
    )
    return workspace


def main() -> int:
    args = parser().parse_args()
    try:
        validate_args(args)
        repo = Path(__file__).resolve().parent.parent
        workspace = prepare_workspace(args, repo)
    except (OSError, ValueError) as error:
        print(f"assembly-run: {error}", file=sys.stderr)
        return 2

    print(f"Prepared workspace: {workspace}")
    if args.prepare_only:
        return 0

    output = args.output.expanduser().resolve()
    output.mkdir(parents=True, exist_ok=True)
    command = [
        args.streamflow_bin,
        "run",
        "--outdir",
        str(output),
        str(workspace / "streamflow.yml"),
    ]
    print("Running:", " ".join(command))
    try:
        return subprocess.run(command, cwd=workspace, check=False).returncode
    except FileNotFoundError:
        print(f"assembly-run: StreamFlow executable not found: {args.streamflow_bin}", file=sys.stderr)
        return 127


if __name__ == "__main__":
    raise SystemExit(main())
